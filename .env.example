# Configurazione Firebase per il client.
#
# Questi valori non sono segreti: finiscono nel bundle e sono leggibili da
# chiunque apra l'app. È previsto dal funzionamento di Firebase sul web. A
# proteggere i dati sono le regole in firestore.rules, che girano sul server.
#
# Si prendono da: console Firebase > Impostazioni progetto > Le tue app > Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo per test e sviluppo locale: con questa impostata l'app usa gli
# emulatori e non contatta mai Google. In produzione deve restare vuota.
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
