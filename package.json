{
  "name": "shadow-calisthenics",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PWA offline per il protocollo di allenamento Calisthenics Shadow",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:no-video-urls": "node scripts/check-no-video-urls.mjs",
    "verify": "npm run typecheck && npm run test && npm run check:no-video-urls",
    "smoke": "node scripts/smoke.mjs",
    "offline": "node scripts/offline.mjs",
    "svg": "node scripts/generate-exercise-svg.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-shadow"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "firebase": "^12.19.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.30.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
